<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{# The one deliberately unescaped value in this template. It is the reason
   `css_presets.validate_css` screens for `<script`, `<style` and `@import` — nothing
   else reaches the page unescaped. #}
{# A comment written before the formatting toolbar existed is plain text, so the line
   breaks in it are the user's own. HTML collapses every newline into a space, which
   would run a three-line comment together as one line — `pre-wrap` keeps the breaks and
   still wraps long lines. The paragraph and list rules keep a formatted comment from
   inheriting the browser's large default margins inside the item box.
   Written *before* the report stylesheet so a preset or a hand-edited sheet can still
   override any of it. #}
<style>
.comment { white-space: pre-wrap; }
.comment p { margin: 0 0 6px; }
.comment p:last-child { margin-bottom: 0; }
.comment ul, .comment ol { margin: 0 0 6px; padding-left: 22px; }
{# A pasted block brings its own look with it, and now brings its own document too:
   it renders in an iframe, so all this says is how big the frame is. The height is the
   user's answer on the block; the frame scrolls inside itself past that.
   Written before the report stylesheet, like the rules above, so a preset still wins. #}
.embed { display: block; width: 100%; max-width: 100%; border: 0; }
.block-picture { max-width: 100%; height: auto; }

{# ---- Folding (phase 22) -------------------------------------------------------------
   Sections and subsections are `<details>` elements, so the folding is the browser's own
   and works in a downloaded file with scripting turned off. Only the Expand all /
   Collapse all pair needs script, and the report is perfectly usable without it.
   The heading stays an `<h2>`/`<h3>` exactly where it was, just inside the `<summary>`,
   so every preset and every hand-edited stylesheet keeps styling it the way it did. The
   arrow is a span *inside* the heading rather than beside it, so a preset that bands the
   whole heading (Corporate does) bands the arrow with it. #}
.fold > summary { cursor: pointer; list-style: none; }
.fold > summary::-webkit-details-marker { display: none; }
.fold > summary::marker { content: ""; }
.fold-mark { display: inline-block; width: 1em; font-size: 0.8em; transition: transform 0.15s ease; }
.fold-mark::before { content: "\25B6"; opacity: 0.55; }
.fold[open] > summary .fold-mark { transform: rotate(90deg); }
.fold > summary:hover .fold-mark::before { opacity: 1; }
.fold-controls { display: flex; gap: 8px; margin: 0 0 8px; }
.fold-controls button {
  font: inherit; font-size: 0.78rem; cursor: pointer; padding: 4px 10px;
  border: 1px solid currentColor; border-radius: 4px; background: transparent;
  color: inherit; opacity: 0.7;
}
.fold-controls button:hover { opacity: 1; }

{# ---- Boxes and polish (phase 22) ----------------------------------------------------
   Light enough to sit under any of the presets: a hairline in the current text colour at
   low opacity, so it reads as a box on a white page and on a tinted one without either
   preset having to know about it. #}
.subsection { border: 1px solid rgba(0, 0, 0, 0.10); border-radius: 8px; padding: 4px 18px 18px; margin: 0 0 22px; }
.item { border: 1px solid rgba(0, 0, 0, 0.07); border-radius: 6px; padding: 2px 16px 16px; background: rgba(0, 0, 0, 0.008); }
.item:hover { border-color: rgba(0, 0, 0, 0.18); box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07); }
{# A long table becomes a scroll box with its column names pinned to the top of it, rather
   than a run of hundreds of rows whose header scrolled off the screen ten seconds ago.
   `th` needs an opaque background or the rows show through it as they pass underneath. #}
.table-wrap { max-height: 70vh; overflow: auto; }
thead th { position: sticky; top: 0; z-index: 1; background: #ffffff; }
tbody tr:nth-child(even) td { background: rgba(0, 0, 0, 0.022); }
{# The button an External Link block prints. Sized in `em` so it follows whatever type
   scale the preset set. #}
.link-button {
  display: inline-block; margin: 6px 0 2px; padding: 9px 18px; border-radius: 6px;
  border: 1px solid currentColor; text-decoration: none; font-weight: 600;
  font-size: 0.92em; line-height: 1.3;
}
.link-button:hover { text-decoration: underline; }
.link-url { font-size: 0.78em; opacity: 0.6; margin: 4px 0 0; word-break: break-all; }
{# Print is the one place none of this may apply: a folded section printed folded is a
   blank page, and a capped table prints one screenful of a thousand rows. The script
   below opens every fold before the print dialog; these rules undo the rest. #}
@media print {
  .fold-controls { display: none; }
  .fold-mark { display: none; }
  .table-wrap { max-height: none; overflow: visible; }
  thead th { position: static; }
  .item, .subsection { break-inside: avoid; box-shadow: none; }
}
{{ css | safe }}
</style>
</head>
<body>
<div class="report">
  {# With a logo the header is a flex row (or column) holding the picture and the two
     lines of text; without one it is exactly the markup it always was, so every preset
     and every hand-edited stylesheet keeps styling an untouched report the way it did.
     `logo` is a `data:` URI built from bytes this app stored — never user-supplied text —
     and the height is an integer clamped by `model.set_logo_height`. #}
  {% if logo %}
  <div class="report-header {{ logo_position }}">
    <img class="report-logo" src="{{ logo }}" alt="{{ title }}" style="height: {{ logo_height }}px;">
    <div class="titles">
      <h1>{{ title }}</h1>
      <p class="subtitle">{{ generated_at }}</p>
    </div>
  </div>
  {% else %}
  <h1>{{ title }}</h1>
  <p class="subtitle">{{ generated_at }}</p>
  {% endif %}

  {% if not sections %}
  <p class="empty">This report has no placed items yet.</p>
  {% endif %}

  {% if sections %}
  <div class="fold-controls">
    <button type="button" data-fold="open">Expand all</button>
    <button type="button" data-fold="close">Collapse all</button>
  </div>
  {% endif %}

  {# Every section and subsection is folded shut on open, so the report starts as its own
     table of contents. `<details>` does the folding itself — no script — which is what
     makes it survive a file opened straight off disk. #}
  {% for section in sections %}
  <details class="fold section">
    <summary><h2><span class="fold-mark" aria-hidden="true"></span>{{ section.number }}. {{ section.name }}</h2></summary>

    {% for subsection in section.subsections %}
    <details class="fold subsection">
      <summary><h3><span class="fold-mark" aria-hidden="true"></span>{{ subsection.number }} {{ subsection.name }}</h3></summary>

      {# `entries`, not `items`: these subsections are dicts, and Jinja resolves
         `.items` on a dict to `dict.items` before it looks at the key. Each entry is a
         *row* of items to sit side by side; a row of one is written bare, so a report
         with no side-by-side items produces exactly the markup it always did. #}
      {% for row in subsection.entries %}
      {% if row | length > 1 %}
      <div class="item-row cols-{{ row | length }}">
      {% endif %}

        {% for item in row %}
        <div class="item">
          <h4>{{ item.number }} {{ item.heading }}</h4>

          {% if item.image %}
          <img src="data:image/png;base64,{{ item.image }}" alt="{{ item.heading }}">
          {% elif item.chart_failed %}
          <p class="note">This chart couldn't be included as a picture. Its data is below.</p>
          {% endif %}

          {# A picture the user put on this block — an Excel chart or pivot they
             screenshotted. `picture` is a `data:` URI built by `model.image_data_uri`
             from bytes this app stored and mime-typed, never from anything typed. #}
          {% if item.picture %}
          <img class="block-picture" src="{{ item.picture }}" alt="{{ item.heading }}">
          {% endif %}

          {# An External Link block. `link_url` reached here through
             `model.link_problems`, which accepts nothing but an `http://` or `https://`
             address — so the one attribute this template writes from typed text cannot
             be a `javascript:` line. `rel="noopener noreferrer"` because the new tab must
             not be handed a reference back to this page. #}
          {% if item.link_url %}
          <p><a class="link-button" href="{{ item.link_url }}" target="_blank" rel="noopener noreferrer">{{ item.link_text }}</a></p>
          {% if item.link_text != item.link_url %}
          <p class="link-url">{{ item.link_url }}</p>
          {% endif %}
          {% endif %}

          {% if item.table %}
          <div class="table-wrap">{{ item.table | safe }}</div>
          {% endif %}
          {% if item.table_note %}
          <p class="note">{{ item.table_note }}</p>
          {% endif %}

          {# Escaped, unlike the three values above, and that is the whole design: the
             pasted page goes into a `srcdoc` attribute as text, and the browser makes a
             separate document of it inside this sandbox — no navigation, no forms, no
             plugins. That frame is what lets `sanitize_embed` keep the paste's own
             `<style>` verbatim, so a page arrives with its buttons, variables and hover
             states intact instead of flattened.
             `allow-scripts allow-same-origin` is what lets a live embed (Power BI and the
             like) run at all — a paste is otherwise only ever markup, never a running page.
             That combination also means a script in the paste can reach this app's own
             origin, which is why it is only accepted here because these reports are
             internal and whoever pastes into one could already edit it either way. #}
          {% if item.embed %}
          <iframe class="embed" sandbox="allow-scripts allow-same-origin" loading="lazy"
                  title="{{ item.heading }}" style="height: {{ item.embed_height }}px;"
                  srcdoc="{{ item.embed }}"></iframe>
          {% endif %}

          {# Unescaped, and safely so: `rich_text.sanitize_comment` has already reduced
             it to an allow-list of formatting tags with no attributes on any of them.
             A `<div>` rather than a `<p>` because a formatted comment can contain
             paragraphs and lists, which a `<p>` may not legally hold. #}
          {% if item.comment %}
          <div class="comment">{{ item.comment | safe }}</div>
          {% endif %}
        </div>
        {% endfor %}

      {% if row | length > 1 %}
      </div>
      {% endif %}
      {% endfor %}

    </details>
    {% endfor %}
  </details>
  {% endfor %}
</div>
{# The only script in the report, and it does two things the folding cannot do for
   itself: the Expand all / Collapse all pair, and opening every fold before the browser
   prints — a section printed folded is a blank page. No user text reaches it. #}
<script>
(function () {
  var folds = function () { return document.querySelectorAll("details.fold"); };

  document.querySelectorAll(".fold-controls button").forEach(function (button) {
    button.addEventListener("click", function () {
      var open = button.getAttribute("data-fold") === "open";
      folds().forEach(function (fold) { fold.open = open; });
    });
  });

  window.addEventListener("beforeprint", function () {
    folds().forEach(function (fold) { fold.open = true; });
  });
})();
</script>
</body>
</html>
